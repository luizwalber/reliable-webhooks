# Copy this file to .env for local use:
#   cp .env.example .env
#
# .env itself is gitignored and never committed. This file (.env.example)
# IS committed, safely, because none of these are real secrets — see
# back_java/.env.example (and README.md) for the same story in more
# detail. This file is the runtime docker-compose.yml's own credentials/
# ports (docs/adr/0011-docker-compose-topology) — separate from, and not
# read by, back_java/docker-compose.test.yml's test-only infra.

POSTGRES_DB=reliable_webhooks
POSTGRES_USER=reliable_webhooks
POSTGRES_PASSWORD=reliable_webhooks

# Host port the backend's /v1 API is reachable on (http://localhost:<this>/v1).
BACKEND_PORT=8080
