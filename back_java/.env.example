# Copy this file to .env for local development:
#   cp .env.example .env
#
# .env itself is gitignored and never committed. This file (.env.example)
# IS committed, safely, because none of these are real secrets — they're
# placeholder credentials for the local docker-compose.test.yml Postgres
# instance, matching src/main/resources/application.yml's defaults. In a
# real deployment, actual credentials live in .env (or a secrets manager)
# and are never committed — see README.md.

POSTGRES_DB=reliable_webhooks
POSTGRES_USER=reliable_webhooks
POSTGRES_PASSWORD=reliable_webhooks
POSTGRES_PORT=5432

REDIS_PORT=6379

KAFKA_PORT=9092
