# Copy this file to .env for local development:
#   cp .env.example .env
#
# .env itself is gitignored and never committed. This file (.env.example)
# IS committed, safely, because none of these are real secrets — they're
# placeholder credentials for the local docker-compose.test.yml infra
# containers, plus app-tuning defaults, all matching
# src/main/resources/application.yml's built-in ${VAR:default} values. In a
# real deployment, actual credentials live in .env (or a secrets manager)
# and are never committed — see README.md.
#
# docker-compose.test.yml reads only the infra vars below (Postgres, Redis,
# Kafka); the app-tuning vars are read directly by the Spring app itself
# (export them in your shell, or via your process manager of choice) —
# application.yml's built-in defaults already match the values here, so
# nothing needs to be set for the app or test suite to run out of the box.

POSTGRES_DB=reliable_webhooks
POSTGRES_USER=reliable_webhooks
POSTGRES_PASSWORD=reliable_webhooks
POSTGRES_PORT=5432

REDIS_PORT=6379

KAFKA_PORT=9092

# --- App tuning (read by the Spring app, not docker-compose) ---

SERVER_PORT=8080

# docs/adr/0003-transactional-outbox
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=50

# docs/adr/0004-retry-policy-and-topic-topology — fast demo-profile delays
# (~10s/30s/2m), not the retry topic names' illustrative 30s/5m/30m values.
RETRY_JITTER=0.2
RETRY_DELAY_BAND_1_MS=10000
RETRY_DELAY_BAND_2_MS=30000
RETRY_DELAY_BAND_3_MS=120000

# docs/adr/0007-hmac-signing
DELIVERY_HTTP_TIMEOUT_MS=3000

# Short session timeout so a rejoin after an abrupt process kill doesn't
# stall the next run's rebalance behind Kafka's 45s default zombie-member
# detection window.
KAFKA_CONSUMER_SESSION_TIMEOUT_MS=6000
KAFKA_CONSUMER_HEARTBEAT_INTERVAL_MS=2000
